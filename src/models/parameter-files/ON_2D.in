#Output
outputfile = ./

#Evolution
expansion = false
evolver = LF

#Lattice
N = 1024
dt = 0.01
kIR = 0.75

#Times
tOutputFreq = 1
tOutputInfreq = 10
tMax = 10


#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs=false

#IC
#kCutOff = 4
initial_amplitudes = 5.6964e18 0  # homogeneous amplitudes in GeV
initial_momenta = -4.86735e30 0   # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 9e-14
m2 = 0.1
A = 0.1
omega = 0.1
