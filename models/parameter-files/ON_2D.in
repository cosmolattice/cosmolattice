#Output
outputfile = ./run_
print_headers = true
overwriteFiles = false

#Evolution
expansion = false
evolver = LF

#Lattice
N = 1024
dt = 0.01
kIR = 0.1 # smallest momentum we resolve

#Times
tOutputFreq = 10
tOutputInfreq = 100
tMax = 1000


#Spectra options
PS_type = 0
PS_version = 1

#GWs
GWprojectorType = 1
withGWs=false

#IC
kCutOff = 1 # cutoff of the initial momentum distribution
initial_amplitudes = 1.0  # homogeneous amplitudes in GeV
initial_momenta = 0   # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 0.1
m2 = 0.1
A = 0.0
omega = 0.1
highCut = 1
lowCut = 0
