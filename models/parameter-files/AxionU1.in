#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = RK2

#Lattice
N = 128
dt = 0.005
kIR = 1

#Times
tOutputFreq = 0.05
tOutputInfreq = 0.5
tOutputRareFreq = 10
tMax = 3

# if t < tNonlinearAxionU1 system will evolve during Linear regime of Axion U(1) else it evolves the full non-linear system 
tNonLinearAxionU1 = 1.5

#Spectra options
withGWs = false # for the current axion-U(1) model not implemented
flagChiralPS=false

#IC
kCutOff = 30
initial_amplitudes = 3.39928e18  # homogeneous amplitudes in GeV
initial_momenta = -3.0714e31     # homogeneous amplitudes in GeV2

#Axion U1 coupling
alphaLambda_AxionU1 = 13

#Model Parameters
Mass = 1.5e13    # mass of the axion in GeV




