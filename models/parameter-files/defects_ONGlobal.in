#Output
outputfile = ./
print_headers = true
overwriteFiles = false

# @label:model_expansion
#Evolution
expansion = true
fixedBackground = true
omegaEoS = 0.333333333333333333
evolver = LF
# @endlabel

#Lattice
N = 64
dt = 0.05
lSide = 32

#Times
tOutputFreq = 1
tOutputInfreq = 1
tOutputRareFreq = 1
t0 = 70
tMax = 102

#Spectra options
PS_type = 1
PS_version = 1

#GWs
withGWs = false
GWprojectorType = 1

# @label:model_parameters
#Model Parameters
lambda = 1
vev = 1
# @endlabel

# @label:model_IC
#IC
ICtype_S = DefectsNetwork
lcorr = 4
# @endlabel

# @label:diffusion
#Diffusion
doDiffusion = true
tmaxdiff = 10
diffusionevolver = RK2
dtdiff = 0.005
tOutputFreqDiff = 1
# @endlabel

# @label:fattening
#Fattening
doFattening = true
sFat = -1
t0Fat = 70
# @endlabel

# @label:observables
#Measurements defects
measureDefectsEnergies = true
measureDefectsStructure = true
# @endlabel
