#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = LF

#Lattice
N = 128
dt = 0.01
kIR = .7

#Times
tOutputFreq = 1
tOutputInfreq = 10
tMax = 100


#Spectra options
PS_type = 1
PS_version = 1

#GWs
GWprojectorType = 1
withGWs=false

#IC
initial_amplitudes = 5.6964e18 0  # homogeneous amplitudes in GeV
initial_momenta = -4.86735e30 0   # homogeneous amplitudes in GeV2

#Model Parameters
lambda = 9e-14
q = 100
