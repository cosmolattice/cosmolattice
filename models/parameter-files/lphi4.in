#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = LF

#Lattice 
N = 64
dt = 0.01
kIR = .7

#Times
tOutputFreq = 0.2
tOutputInfreq = 1
tMax = 10

#Spectra options
PS_type = 1
PS_version = 1
saveUnbinnedSpectra = false

#@label:GW_settings 
#GWs
withGWs=false
GWprojectorType = 1
#@label:GW_settings 

#@label:IC 
#IC
initial_amplitudes = 5.6964e18 0  # homogeneous amplitudes in GeV
initial_momenta = -4.86735e30 0   # homogeneous amplitudes in GeV2
#@endlabel

#Model Parameters
lambda = 9e-14
q = 300
