#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.01
kIR = 2

#Times
tOutputFreq = 0.1
tOutputInfreq = 3
tOutputRareFreq = 10
tMax = 100

# @label:initial_conditions
#IC
kCutOff = 6
initial_amplitudes = 0
initial_momenta = 0
cmplx_field_initial_norm = 0
cmplx_momentum_initial_norm = 0
SU2Doublet_initial_norm = 5.25151e18          # homogeneous amplitudes in GeV
SU2Doublet_initial_momenta_norm = -4.45258e30 # homogeneous amplitudes in GeV2
# @endlabel

# @label:gauge_couplings
#Gauge couplings and effectiveCharges
CSU1Charges = 1
SU2DoubletU1Charges = 1
SU2DoubletSU2Charges = 1
gU1s = 1.11037e-05
gSU2s = 2.22075e-05
# @endlabel

# @label:model_parameters
#Model Parameters
qG = 50
qH = 50
lambda = 9e-14
# @endlabel
