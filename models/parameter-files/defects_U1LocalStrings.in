#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
fixedBackground = true
omegaEoS = 0.333333333333333333
evolver = LF

#Lattice
N = 64
dt = 0.01
lSide = 32

#Times
tOutputFreq = 1
tOutputInfreq = 1
tOutputRareFreq = 1
t0 = 70
tMax = 102

#Spectra options
PS_type = 1
PS_version = 1

#GWs
withGWs = false
GWprojectorType = 1

#IC
ICtype_U1 = DefectsNetwork
lcorr = 4

#Model Parameters. Default corresponds to the critical case of local strings.
CSU1Charges = 1
gU1s = 1
lambda = 0.5
vev = 1

#Diffusion
doDiffusion = true
diffusionevolver = RK2
dtdiff = 0.005
tmaxdiff = 5
tOutputFreqDiff = 1
tOutputRareFreqDiff = 1
#snapshots_diffusion = CS

#Fattening
doFattening = true
sFat = 0.
t0Fat = 70.

#Measurements defects
measureDefectsEnergies = true
measureDefectsStructure = true
